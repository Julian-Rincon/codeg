# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
tsconfig.tsbuildinfo

# Next.js
.next/
out/
next-env.d.ts

# Monaco editor local files (copied from node_modules)
public/vs

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test artifacts
coverage/
*.snap.new
.vitest-cache/

# macOS signing material. Keep certificates and exported private keys out of git.
*.cer
*.csr
*.p12
certificate-base64.txt

# Agent
.claude
.docs
docs/superpowers

# Tauri sidecar staging (built per-target by prepare-sidecars.mjs).
# The binaries are platform-specific build artifacts; ship them through
# release.yml, not git.
src-tauri/binaries/

# pnpm local store (pnpm 11+)
.pnpm-store/

# `rustc foo.rs` with no -o writes its binary here. Scratch compiles are how
# you check a borrow or a lifetime question in isolation, and the leftover
# executable then sits untracked in the repo root — which is enough to fail a
# work task's "worktree is clean" check at delivery.
/rust_out

# ---------------------------------------------------------------------------
# Phantom UI local state — never publish these. Runtime secrets, local
# databases, generated tooling output and session-note directories that
# belong to one deployment, not the repo.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
server.env
*.db
# ...except tracked upstream test fixtures: real fixture data the parser
# tests assert against, not local runtime state.
!src-tauri/tests/fixtures/**/*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# graphify's AST-index build output (ast graph.json) — regenerated locally,
# not source.
/graphify-out/
*.backup-*
reports/
.remember/
*.pem
*.key
